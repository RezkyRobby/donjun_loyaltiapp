NODE_ENV="development"

# Public Environment Variables (exposed to browser)
NEXT_PUBLIC_APP_NAME="Donjun Donat Loyalty"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Site URL untuk metadata/OG image (set ke domain produksi, mis. https://loyalty.donjundonat.com)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database
DATABASE_URL=""

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Transaksional — Gmail SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Donjun Donat <no-reply@donjundonat.com>"

# Media Storage — Cloudinary (gambar promo)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Observability
SENTRY_DSN=""

# Business Rules
POINT_COOLDOWN_SECONDS="60"

# Seeder — akun SUPER_ADMIN (hanya dipakai `prisma db seed`, bukan runtime aplikasi)
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
